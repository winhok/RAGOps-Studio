# Zero-key local demo (default)
RAGOPS_AUTO_SEED=1
RAGOPS_DB_PATH=./data/ragops.db
RAGOPS_EMBEDDING_MODE=offline
RAGOPS_VECTOR_BACKEND=memory
RAGOPS_ANSWER_MODE=offline
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO


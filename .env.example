# Runtime: all choices are explicit. Missing selected SDKs/keys cause an error;
# the service never silently substitutes a local provider for a remote one.
RAGOPS_GRAPH_ENGINE=python
RAGOPS_MODEL_PROVIDER=local
RAGOPS_EMBEDDING_PROVIDER=hash
RAGOPS_RERANK_PROVIDER=lexical
RAGOPS_VECTOR_BACKEND=local
EMBEDDING_DIMENSIONS=512
RAGOPS_MAX_SEARCHES=3
RAGOPS_MAX_ACTIVE_CHUNKS=5000
RAGOPS_MAX_UPLOAD_BYTES=2000000
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_HTTP_ATTEMPTS=3
VECTOR_COLLECTION=ragops_chunks_v2
# Paths default to <project>/.state and <project>/.secrets/principals.json.
# RAGOPS_STATE_DIR=
# RAGOPS_PRINCIPALS_FILE=

# Install requirements-integrations.txt, then choose "langgraph" explicitly.
# RAGOPS_GRAPH_ENGINE=langgraph

# Zhipu embedding + rerank + generation. Choose model IDs available to your account.
# RAGOPS_MODEL_PROVIDER=zhipu
# RAGOPS_EMBEDDING_PROVIDER=zhipu
# RAGOPS_RERANK_PROVIDER=zhipu
# ZHIPU_API_KEY=
# CHAT_MODEL=glm-4.7-flash
# EMBEDDING_MODEL=embedding-3
# RERANK_MODEL=rerank

# Alternative chat provider from 08-agentic-rag:
# RAGOPS_MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# CHAT_MODEL=deepseek-v4-flash

# Milvus native dense + BM25 hybrid search:
# RAGOPS_VECTOR_BACKEND=milvus
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=

# Preserved alternatives from the existing RAGOps implementation:
# RAGOPS_MODEL_PROVIDER=openai
# RAGOPS_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=
# EMBEDDING_MODEL=
# RAGOPS_VECTOR_BACKEND=qdrant
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
